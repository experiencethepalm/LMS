 "project": {
  "name": "The Palm Unity",
  "tagline": "Rising Above Kudasan, Rooted in Zen Living",
  "location": "Kudasan, Gandhinagar",
  "developer": "The Palm Group",
  "type": "Residential apartments",
  "possession": "December 2030",
  "rera": "PR/GJ/GANDHINAGAR/GANDHINAGAR/Gandhinagar Municipal Corporation/RAA17286/210826/311232",
  "about": "The Palm Unity is a Zen Living address by The Palm Group in Kudasan, Gandhinagar — a single exclusive 20-storey tower on a dual-road frontage, with spacious 3 & 4 BHK homes and penthouses, four Sky Bridges, a Terrace Garden and The Sky Hall high above the city."
 },
 "highlights": [
  {
   "title": "One Address. Two Roads. Zero Compromise.",
   "text": "A single exclusive tower rising on a rare dual-road frontage — 24 m and 36 m wide — giving every home uninterrupted light, air and views most single towers can't offer."
  },
  {
   "title": "Ground Floor, Reserved for Living — Not Parking.",
   "text": "Three levels of basement parking mean the ground floor belongs entirely to residents, not vehicles — the first step into Unity is a lobby, not a parking lane."
  },
  {
   "title": "Where the Sky Becomes Common Ground.",
   "text": "Four Sky Bridges connect a landscaped Terrace Garden and The Sky Hall — turning the upper levels into Unity's real social address, high above the city."
  },
  {
   "title": "Kudasan's Only 20-Storey Address.",
   "text": "Standing 20 storeys tall, The Palm Unity isn't just Kudasan's tallest residential building — it's the only one built at this scale, anywhere in the neighbourhood."
  },
  {
   "title": "The Largest Foyers in the Segment.",
   "text": "At 1,885 sq. ft. per floor, Unity's foyers are open on all sides for natural ventilation — fitted with Jullas and seating benches for 12–14 people, turning every floor's entrance into a gathering space, not just a hallway."
  },
  {
   "title": "Two Doors, Twice the Convenience.",
   "text": "Every apartment at Unity opens through two separate entries — a main entrance and a dedicated service entry — so daily deliveries, staff and everyday convenience never have to pass through your main door."
  }
 ],
